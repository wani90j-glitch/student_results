# Copy to .env.local (never commit .env.local). Values come from Supabase → Project Settings → API, and from Anthropic.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ITQAN_AI_MODEL=claude-opus-5-5
# 32+ random characters; keep it secret and never change it after the import (all student PINs depend on it)
PIN_PEPPER=
APP_URL=https://itqan.vercel.app
